<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="My" GeneratedClassName="MySettings" UseMySettingsClassName="true">
  <Profiles />
  <Settings>
    <Setting Name="w_mode" Type="System.String" Scope="User">
      <Value Profile="(Default)">STATIC</Value>
    </Setting>
    <Setting Name="portname" Type="System.String" Scope="User">
      <Value Profile="(Default)" />
    </Setting>
    <Setting Name="baudrate" Type="System.String" Scope="User">
      <Value Profile="(Default)">9600</Value>
    </Setting>
    <Setting Name="databits" Type="System.String" Scope="User">
      <Value Profile="(Default)">8</Value>
    </Setting>
    <Setting Name="stopbits" Type="System.String" Scope="User">
      <Value Profile="(Default)">1</Value>
    </Setting>
    <Setting Name="readtimeout" Type="System.String" Scope="User">
      <Value Profile="(Default)">10000</Value>
    </Setting>
    <Setting Name="permittedweightperaxle" Type="System.Int32" Scope="User">
      <Value Profile="(Default)">13500</Value>
    </Setting>
    <Setting Name="serialnumber" Type="System.String" Scope="User">
      <Value Profile="(Default)">unknown</Value>
    </Setting>
    <Setting Name="calibrationnumber" Type="System.String" Scope="User">
      <Value Profile="(Default)">unknown</Value>
    </Setting>
  </Settings>
</SettingsFile>